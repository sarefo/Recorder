"Dm"d4 "A"e2^c2 |"Dm"d6 f2 |"Am"e2f2 g2e2 |"F"f8 |
"Dm"a4 g2f2 |"Gm"g6 f2 |"Dm"e2f2 d2e2 |"A"^c4 A4 |
"Dm"a4 g2f2 |"Gm"g6 f2 |"A"e2d2 ^c2 "Dm"d2 |"Dm"A4 z2 A2 |
"Dm"d3^c d2e2 |"Dm"f4 e2f2 |"Gm"g2g2 "Dm"f2e2 |"Dm"f4 e2a2 |
